+void Bindings::flattenBase() const
+{
+    auto & base = *baseLayer;
+    size_t capacity = 0;
+    for (const Bindings * layer = &base; layer; layer = layer->baseLayer)
+        capacity += layer->numAttrs;
+
+    size_t bytes = sizeof(Bindings) + capacity * sizeof(Attr);
+#if NIX_USE_BOEHMGC
+    void * p = GC_MALLOC(bytes);
+#else
+    void * p = calloc(bytes, 1);
+#endif
+    if (!p)
+        throw std::bad_alloc();
+    auto flat = new (p) Bindings();
+    flat->pos = base.pos;
+    for (auto & attr : base)
+        flat->attrs[flat->numAttrs++] = attr;
+    flat->numAttrsInChain = flat->numAttrs;
+    baseLayer = flat;
+}
