+/* Merges the layers, topmost first: at each step take the smallest name among
+   the layers, from the topmost layer that has it, then skip that name in every
+   layer. That also skips names repeated within one layer, as the heap merge
+   did */
+const Bindings & Bindings::flatten() const
+{
+    struct Cursor
+    {
+        const Attr * current;
+        const Attr * end;
+    };
+
+    Cursor cursors[maxLayers];
+    uint32_t numCursors = 0;
+    size_t capacity = 0;
+    for (const Bindings * layer = this; layer; layer = layer->baseLayer)
+        if (layer->numAttrs != 0) {
+            cursors[numCursors++] = {layer->attrs, layer->attrs + layer->numAttrs};
+            capacity += layer->numAttrs;
+        }
+
+    size_t bytes = sizeof(Bindings) + capacity * sizeof(Attr);
+#if NIX_USE_BOEHMGC
+    void * p = GC_MALLOC(bytes);
+#else
+    void * p = calloc(bytes, 1);
+#endif
+    if (!p)
+        throw std::bad_alloc();
+    auto res = new (p) Bindings();
+    res->pos = pos;
+
+    while (numCursors != 0) {
+        const Attr * best = cursors[0].current;
+        for (uint32_t i = 1; i < numCursors; ++i)
+            if (cursors[i].current->name < best->name)
+                best = cursors[i].current;
+        res->attrs[res->numAttrs++] = *best;
+
+        Symbol last = best->name;
+        uint32_t kept = 0;
+        for (uint32_t i = 0; i < numCursors; ++i) {
+            Cursor c = cursors[i];
+            while (c.current != c.end && c.current->name <= last)
+                ++c.current;
+            if (c.current != c.end)
+                cursors[kept++] = c;
+        }
+        numCursors = kept;
+    }
+    res->numAttrsInChain = res->numAttrs;
+
+    flattened = res;
+    return *res;
+}
