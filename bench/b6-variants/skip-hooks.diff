diff --git a/src/libexpr/eval.cc b/src/libexpr/eval.cc
index 0ebbb5996..6287d968e 100644
--- a/src/libexpr/eval.cc
+++ b/src/libexpr/eval.cc
@@ -1815,14 +1815,24 @@ void EvalState::callFunction(Value & fun, std::span<Value * const> args, Value &
     auto _level = addCallDepth(pos);
 
     auto neededHooks = profiler.getNeededHooks();
-    if (neededHooks.test(EvalProfiler::preFunctionCall)) [[unlikely]]
+    if (neededHooks.none()) [[likely]] {
+        callFunctionUnhooked(fun, args, vRes, pos);
+        return;
+    }
+
+    if (neededHooks.test(EvalProfiler::preFunctionCall))
         profiler.preFunctionCallHook(*this, fun, args, pos);
 
     Finally traceExit_{[&]() {
-        if (profiler.getNeededHooks().test(EvalProfiler::postFunctionCall)) [[unlikely]]
+        if (profiler.getNeededHooks().test(EvalProfiler::postFunctionCall))
             profiler.postFunctionCallHook(*this, fun, args, pos);
     }};
 
+    callFunctionUnhooked(fun, args, vRes, pos);
+}
+
+void EvalState::callFunctionUnhooked(Value & fun, std::span<Value * const> args, Value & vRes, const PosIdx pos)
+{
     forceValue(fun, pos);
 
     Value vCur(fun);
